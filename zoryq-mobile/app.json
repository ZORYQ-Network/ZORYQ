{
  "expo": {
    "name": "ZORIQ",
    "slug": "zoryq-wallet",
    "scheme": "zoriq",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/zoryq-icon.png",
    "ios": {
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "metamask",
          "trust",
          "safe",
          "rainbow",
          "uniswap",
          "zerion"
        ]
      }
    },
    "android": {
      "package": "com.zoryq.wallet",
      "versionCode": 3,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/zoryq-icon.png",
        "backgroundColor": "#050609"
      }
    },
    "plugins": [
      "expo-secure-store",
      "./queries.js",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o ZORIQ use Face ID para desbloquear o aplicativo e proteger o acesso à wallet."
        }
      ]
    ]
  }
}
