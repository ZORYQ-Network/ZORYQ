{
  "expo": {
    "name": "ZORYQ",
    "slug": "zoryq-super-app",
    "version": "1.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.zoryq.wallet",
      "versionCode": 9,
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.zoryq.wallet",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permita que a ZORYQ use o Face ID para proteger sua carteira."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que a ZORYQ acesse suas fotos para publicar imagens no feed.",
          "cameraPermission": "Permita que a ZORYQ use a câmera para criar conteúdo.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
