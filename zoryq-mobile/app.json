{
  "expo": {
    "name": "ZORIQ",
    "slug": "zoryq-wallet",
    "scheme": "zoriq",
    "version": "0.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/zoryq-icon.png",
    "androidStatusBar": {
      "backgroundColor": "#07080d",
      "barStyle": "light-content",
      "translucent": false
    },
    "ios": {
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "metamask",
          "trust",
          "safe",
          "rainbow",
          "uniswap",
          "zerion"
        ]
      }
    },
    "android": {
      "package": "com.zoryq.wallet",
      "versionCode": 4,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/zoryq-icon.png",
        "backgroundColor": "#050609"
      }
    },
    "plugins": [
      "expo-secure-store",
      "./queries.js",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o ZORIQ use Face ID para desbloquear o aplicativo e proteger o acesso à wallet."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o ZORIQ acesse suas fotos para você escolher uma foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
