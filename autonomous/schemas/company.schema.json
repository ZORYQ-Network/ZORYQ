{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoryq.example/schemas/autonomous-company.schema.json",
  "title": "ZORYQ Autonomous Company",
  "type": "object",
  "required": ["version", "companyId", "chainId", "rootController", "goal", "budget", "autonomy", "policy", "status"],
  "properties": {
    "version": {"type": "string", "const": "0.1"},
    "companyId": {"type": "string", "minLength": 1},
    "chainId": {"type": "integer", "const": 5919065},
    "rootController": {"type": "string", "pattern": "^0x[a-fA-F0-9]{40}$"},
    "goal": {
      "type": "object",
      "required": ["description", "successCriteria", "goalHash"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "successCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "goalHash": {"type": "string", "pattern": "^0x[a-fA-F0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["asset", "initial", "committed", "spent", "received"],
      "properties": {
        "asset": {"type": "string", "minLength": 1},
        "initial": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "committed": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "spent": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "received": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}
      },
      "additionalProperties": false
    },
    "autonomy": {"type": "string", "enum": ["supervised", "balanced", "autonomous"]},
    "policy": {
      "type": "object",
      "required": ["policyId", "maxTotalSpend", "emergencyStop", "permissions"],
      "properties": {
        "policyId": {"type": "string", "minLength": 1},
        "maxTotalSpend": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "emergencyStop": {"type": "boolean"},
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["permissionId", "agentId", "target", "method", "maxValue", "expiresAt", "nonce", "domain", "revoked"],
            "properties": {
              "permissionId": {"type": "string", "minLength": 1},
              "agentId": {"type": "string", "minLength": 1},
              "target": {"type": "string", "pattern": "^0x[a-fA-F0-9]{40}$"},
              "method": {"type": "string", "minLength": 1},
              "maxValue": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
              "expiresAt": {"type": "string", "format": "date-time"},
              "nonce": {"type": "string", "minLength": 1},
              "domain": {"type": "string", "minLength": 1},
              "revoked": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "status": {"type": "string", "enum": ["draft", "active", "paused", "completed", "cancelled"]}
  },
  "additionalProperties": false
}
