{
  "schema": "zoryq-super-app-ui-contract-v2",
  "version": "2.0.0",
  "rule": "Web and APK are two responsive clients of the same ZORYQ product. They must expose the same user-facing modules, field names, social actions, data semantics and visual identity. Screen placement may adapt to viewport size, but product capability, naming and brand parity are mandatory.",
  "brand": {
    "productName": "ZORYQ",
    "descriptor": "BEYOND BLOCKCHAIN",
    "visualDirection": "premium vivid Web3, professional, dark glass surfaces, tone-on-tone gradients, controlled neon glow, high contrast and restrained motion",
    "background": "#090A10",
    "backgroundSoft": "#11121A",
    "panel": "#121522",
    "panelSecondary": "#191D2B",
    "panelGlass": "rgba(18,21,34,0.82)",
    "border": "rgba(104,91,199,0.30)",
    "text": "#F3F0EB",
    "muted": "#A8A4B5",
    "lime": "#DAFF02",
    "orange": "#FE572A",
    "violet": "#685BC7",
    "magenta": "#F30EBB",
    "cyan": "#00B0FF",
    "green": "#25D366",
    "teal": "#128C7E",
    "tealDark": "#075E54",
    "cream": "#F3F0EB",
    "black": "#201E1F",
    "primary": "#685BC7",
    "accent": "#DAFF02",
    "success": "#25D366",
    "warning": "#FFC107",
    "danger": "#FE572A",
    "gradients": {
      "primary": ["#685BC7", "#F30EBB", "#FE572A"],
      "electric": ["#00B0FF", "#685BC7", "#F30EBB"],
      "lime": ["#DAFF02", "#25D366"],
      "warm": ["#DAFF02", "#FE572A"]
    },
    "radius": 18,
    "radiusLarge": 26,
    "darkOnly": true,
    "rules": [
      "Use vivid colors as hierarchy and emphasis, never as uncontrolled full-screen noise.",
      "Prefer tone-on-tone gradients and soft glows over flat saturated fills.",
      "Keep primary content readable on near-black surfaces.",
      "Cards, inputs, navigation, wallet, explorer, social, docs and node surfaces must feel like one product family.",
      "Success states use green; warnings use amber/yellow; destructive states use orange-red; product emphasis uses violet/magenta/cyan/lime.",
      "Respect reduced-motion preferences."
    ]
  },
  "identity": {
    "accountKey": "walletAddress",
    "profileRegistration": "EIP-712",
    "chainId": 5919065,
    "fields": ["@handle", "Nome", "Bio"],
    "sync": ["profile", "posts", "likes", "comments", "reposts", "bookmarks", "followers", "following", "communities", "messages"]
  },
  "primaryNavigation": ["Home", "Explorar", "Criar", "Atividade", "Perfil"],
  "productNavigation": ["Comunidades", "Mensagens", "Wallet", "Swap"],
  "feedScopes": ["Para você", "Seguindo", "Salvos"],
  "composer": {
    "types": ["Texto", "Imagem", "Token", "Transação", "dApp"],
    "commonFields": ["Conteúdo"],
    "imageFields": ["Foto"],
    "tokenFields": ["Chain ID", "Contrato", "Símbolo", "Nome"],
    "transactionFields": ["Chain ID", "Hash"],
    "dappFields": ["Chain ID", "Nome", "HTTPS URL"]
  },
  "postActions": ["Curtir", "Comentar", "Repostar", "Salvar", "Compartilhar", "$ Transferir"],
  "socialTransfer": {
    "icon": "$",
    "recipient": "post.author.walletAddress",
    "requiresExplicitConfirmation": true,
    "reviewFields": ["@usuário", "Wallet destinatária", "Rede", "Valor", "Taxa estimada"],
    "mustNeverAutoSend": true
  },
  "profileStats": ["Seguidores", "Seguindo", "Posts", "Reputação"],
  "responsivePolicy": {
    "allowed": ["sidebar-on-desktop", "bottom-navigation-on-mobile", "multi-column-desktop", "single-column-mobile"],
    "forbidden": ["different-fields", "different-module-names", "different-brand-colors", "different-data-source", "feature-only-on-one-client"]
  }
}
