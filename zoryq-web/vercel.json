{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/zoriq", "destination": "/social", "permanent": true },
    { "source": "/zoriq-social", "destination": "/social", "permanent": true },
    { "source": "/zoriq-social.html", "destination": "/social", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/home-v2.html" },
    { "source": "/start", "destination": "/start.html" },
    { "source": "/mobile-node", "destination": "/mobile-node.html" },
    { "source": "/download", "destination": "/mobile-node.html" },
    { "source": "/lab", "destination": "/testnet-lab.html" },
    { "source": "/clock", "destination": "/network-clock.html" },
    { "source": "/explorer", "destination": "/explorer.html" },
    { "source": "/faucet", "destination": "/faucet.html" },
    { "source": "/social", "destination": "/zoryq-social.html" },
    { "source": "/zoryq-social", "destination": "/zoryq-social.html" },
    { "source": "/proof", "destination": "/proof.html" },
    { "source": "/developer", "destination": "/developer.html" },
    { "source": "/swap", "destination": "/swap.html" },
    { "source": "/stake", "destination": "/stake.html" },
    { "source": "/lending", "destination": "/lending.html" },
    { "source": "/tx/:hash", "destination": "/explorer.html" },
    { "source": "/address/:address", "destination": "/explorer.html" },
    { "source": "/block/:block", "destination": "/explorer.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://zoryq-evm-node-live-production.up.railway.app https://zoryq-wallet-swap-production.up.railway.app; upgrade-insecure-requests" }
      ]
    }
  ]
}
