{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoryq.dev/schemas/project-manifest.schema.json",
  "title": "ZORYQ Project Manifest",
  "type": "object",
  "required": ["version", "chainId", "slug", "name", "builder", "contracts", "links", "status"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "chainId": {"const": 5919065},
    "slug": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{1,46}[a-z0-9])?$", "minLength": 3, "maxLength": 48},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 500},
    "builder": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
        "ens": {"type": ["string", "null"], "maxLength": 255}
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["address", "name", "kind", "active"],
        "properties": {
          "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "kind": {"enum": ["app", "token", "nft", "dex", "stake", "lending", "registry", "oracle", "other"]},
          "active": {"type": "boolean"},
          "deploymentTxHash": {"type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$"},
          "deploymentBlock": {"type": ["integer", "null"], "minimum": 0},
          "sharedIntegration": {"type": "boolean", "default": false}
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "website": {"type": ["string", "null"], "format": "uri", "maxLength": 2048},
        "repository": {"type": ["string", "null"], "format": "uri", "maxLength": 2048},
        "docs": {"type": ["string", "null"], "format": "uri", "maxLength": 2048},
        "x": {"type": ["string", "null"], "format": "uri", "maxLength": 2048}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["experimental", "testnet", "paused", "archived"]},
    "createdAt": {"type": ["string", "null"], "format": "date-time"},
    "updatedAt": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
