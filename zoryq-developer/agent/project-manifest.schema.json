{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoryq.dev/schemas/project-manifest.schema.json",
  "title": "ZORYQ Project Manifest",
  "type": "object",
  "required": ["version", "chainId", "slug", "name", "builder", "contracts", "links", "status"],
  "properties": {
    "version": {"type": "string"},
    "chainId": {"const": 5919065},
    "slug": {"type": "string", "pattern": "^[a-z0-9-]{3,48}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 500},
    "builder": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
        "ens": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "role"],
        "properties": {
          "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
          "role": {"type": "string", "minLength": 1},
          "deploymentTx": {"type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "app": {"type": ["string", "null"], "format": "uri"},
        "repository": {"type": ["string", "null"], "format": "uri"},
        "actions": {"type": ["string", "null"], "format": "uri"}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["experimental", "testnet", "paused", "archived"]},
    "analytics": {
      "type": "object",
      "description": "Optional declared analytics endpoints. ZORYQ should independently derive on-chain metrics instead of trusting self-reported numbers.",
      "properties": {
        "events": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
