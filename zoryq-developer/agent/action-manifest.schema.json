{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoryq.dev/schemas/action-manifest.schema.json",
  "title": "ZORYQ Action Manifest",
  "type": "object",
  "required": ["version", "chainId", "title", "action", "transaction", "safety"],
  "properties": {
    "version": {"type": "string"},
    "chainId": {"const": 5919065},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "action": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "kind": {"enum": ["contract_call", "native_transfer", "deploy"]}
      },
      "additionalProperties": false
    },
    "transaction": {
      "type": "object",
      "required": ["to", "method", "valueWei", "args"],
      "properties": {
        "to": {"type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{40}$"},
        "method": {"type": "string"},
        "valueWei": {"type": "string", "pattern": "^[0-9]+$"},
        "args": {"type": "array"}
      }
    },
    "preview": {
      "type": "object",
      "properties": {
        "expectedAssetIn": {"type": "string"},
        "expectedAssetOut": {"type": "string"},
        "minimumReceived": {"type": "string"},
        "estimatedGas": {"type": "string"}
      }
    },
    "safety": {
      "type": "object",
      "required": ["requiresWalletConfirmation", "testnetOnly"],
      "properties": {
        "requiresWalletConfirmation": {"const": true},
        "testnetOnly": {"const": true},
        "neverRequestSeedPhrase": {"const": true}
      }
    }
  },
  "additionalProperties": false
}
