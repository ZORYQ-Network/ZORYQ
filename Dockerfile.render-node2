FROM ghcr.io/paradigmxyz/reth:v2.5.2 AS reth
FROM node:22-bookworm-slim AS node
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 libgcc-s1 libatomic1 && rm -rf /var/lib/apt/lists/*
COPY --from=reth /usr/local/bin/reth /usr/local/bin/reth
COPY --from=node /usr/local /usr/local
WORKDIR /app
COPY infra/node2/zoryq-testnet-genesis-frozen.json /app/zoryq-reth-genesis.json
COPY render-node2.mjs /app/render-node2.mjs
ENV PORT=10000
ENV ZORYQ_CHAIN_ID=5919065
ENV ZORYQ_RETH_HTTP_PORT=8545
ENV ZORYQ_RETH_DATA_DIR=/tmp/zoryq-render-node2
ENV ZORYQ_GENESIS_SHA256=72c95adbe5206021ada0aeb2123144de7aedd11c4e709e7434b292435e35737c
EXPOSE 10000
CMD ["node","/app/render-node2.mjs"]
